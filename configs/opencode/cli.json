{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": { "name": "gruvbox" },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "none",
    "image_preview": true,
    "new_location": "inherit"
  },
  "tabs": {
    "indicators": "status",
    "scope": "global",
    "layout": "horizontal",
    "mode": "on"
  },
  "diffs": {
    "single": false
  },
  "prompt": {
    "image_preview": true
  },
  "debug": {
    "devtools": true,
    "turn_tokens": true
  }
}
