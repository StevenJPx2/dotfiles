{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "../../Documents/Projects/opencode-plugins/packages/quick-quote"
  ],
  "theme": {
    "name": "gruvbox",
    "mode": "dark"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "none",
    "image_preview": true,
    "new_location": "inherit",
    "verbosity": "high"
  },
  "tabs": {
    "indicators": "status",
    "scope": "global",
    "layout": "horizontal",
    "mode": "on"
  },
  "diffs": {
    "single": false
  },
  "prompt": {
    "image_preview": true
  },
  "debug": {
    "devtools": true,
    "turn_tokens": true
  },
  "experimental": {
    "new-designs": true,
    "client-mcp": true
  }
}
