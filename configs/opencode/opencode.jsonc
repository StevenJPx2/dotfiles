{
  "$schema": "https://opencode.ai/config.json",
  "experimental": { "todo": true, "subagent_depth": 2, "background_compaction": true },
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@2.0.0-next.6",
    "@fdcn/sourcefed@0.3.6",
    "/Users/stevenjohn/Documents/Projects/opencode-todos",
    // opencode-history loads from plugins/opencode-history, which `bun run release` in that repo points at a release.
  ],
  "model": "anthropic/claude-opus-5-5",
  "providers": {
    "anthropic": {
      "settings": { "cache": { "ttl": "1h" } },
    },
  },
  "mcp": {
    "servers": {
      "homeassistant": {
        "type": "local",
        "command": [
          "python3",
          "/Users/stevenjohn/.config/opencode/homeassistant-mcp-proxy.py",
        ],
        "environment": {
          "HOMEASSISTANT_TOKEN": "{env:HOMEASSISTANT_TOKEN}",
        },
      },
      "jina": {
        "type": "remote",
        "url": "https://mcp.jina.ai/v1",
        "headers": {
          "Authorization": "Bearer {env:JINA_API_KEY}",
        },
        "disabled": true,
      },
      "safari": {
        "type": "local",
        "command": ["npx", "-y", "safari-mcp@2.15.11"],
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      },
      "browser-harness": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "browser-harness[mcp]",
          "browser-harness-mcp",
        ],
        "environment": {
          "BU_NAME": "opencode-browser",
          "BH_TAB_MARKER": "1",
        },
      },
      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp"],
        "environment": {
          "AGENT_BROWSER_SESSION": "opencode",
        },
      },
      "iMCP": {
        "type": "local",
        "command": ["/Applications/iMCP.app/Contents/MacOS/imcp-server"],
      },
      "affinity": {
        "type": "local",
        "command": [
          "node",
          "/Users/stevenjohn/Documents/Projects/affinity-mcp/dist/index.js",
        ],
      },
      "grep-app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "oauth": false,
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "oauth": {
          "client_id": "{env:FIGMA_CLIENT_ID}",
          "client_secret": "{env:FIGMA_CLIENT_SECRET}",
        },
        "disabled": true,
      },
      "tampermonkey": {
        "type": "local",
        "command": ["npx", "-y", "tampermonkey-mcp@latest"],
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "oauth": {},
      },
      "google-workspace-personal": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "cd \"$HOME/.config/google-workspace-personal\" && GEMINI_CLI_WORKSPACE_FORCE_FILE_STORAGE=true exec node workspace-server/dist/index.js --debug --use-dot-names",
        ],
      },
      "google-workspace-work": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "cd \"$HOME/.config/google-workspace-work\" && GEMINI_CLI_WORKSPACE_FORCE_FILE_STORAGE=true exec node workspace-server/dist/index.js --debug --use-dot-names",
        ],
      },
    },
  },
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "./*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "~/.claude/skills/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/*",
      "effect": "allow",
    },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/private/tmp/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/var/tmp/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/private/var/tmp/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/*",
      "effect": "allow",
    },
    { "action": "external_directory", "resource": "/dev/*", "effect": "allow" },
  ],
  "agents": {
    "title": {
      "model": "opencode/minimax-m2.5-free",
    },
  },
}
