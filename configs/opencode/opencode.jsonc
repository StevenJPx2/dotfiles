{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
  ],
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.8.1",
    "@cortexkit/aft-opencode@0.50.0",
    "@cortexkit/opencode-magic-context@0.36.1",
    "@whisperopencode/push@0.3.0",
    "@dietrichgebert/ponytail",
    "@fdcn/sourcefed@0.2.4",
  ],
  "compaction": { "auto": false, "prune": false },
  "model": "opencode-go/mimo-v2.5-pro",
  "small_model": "opencode/minimax-m2.5-free",
  "mcp": {
    "lightpanda": {
      "type": "local",
      "command": ["lightpanda", "mcp"],
      "enabled": true,
    },
    "safari": {
      "type": "local",
      "command": ["npx", "-y", "safari-mcp@2.15.11"],
      "enabled": true,
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false,
    },
    "nuxt-ui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": false,
    },
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp",
      "enabled": false,
    },
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "oauth": false,
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientId": "{env:FIGMA_CLIENT_ID}",
        "clientSecret": "{env:FIGMA_CLIENT_SECRET}",
      },
      "enabled": false,
    },
    "tampermonkey": {
      "type": "local",
      "command": ["npx", "-y", "tampermonkey-mcp@latest"],
      "enabled": true,
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {},
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {},
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {},
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {},
    },
  },
  "permission": {
    "websearch": "allow",
    "external_directory": {
      "./*": "allow",
      "~/.claude/skills/*": "allow",
      "~/.agents/skills/*": "allow",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/tmp/*": "allow",
      "/private/var/tmp/*": "allow",
      "/private/var/folders/*": "allow",
      "/dev/*": "allow",
    },
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
    },
  },
}
