{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
  ],
  "plugin": [
    "@cortexkit/opencode-anthropic-auth@1.21.0",
    "@cortexkit/aft-opencode@0.54.0",
    "@cortexkit/opencode-magic-context@0.41.0",
    "@whisperopencode/push@0.3.0",
    "@dietrichgebert/ponytail@4.9.0",
    "@fdcn/sourcefed@0.2.4",
  ],
  "compaction": { "auto": false, "prune": false },
  "model": "opencode-go/mimo-v2.5-pro",
  "small_model": "opencode/minimax-m2.5-free",
  "mcp": {
    "homeassistant": {
      "type": "remote",
      "url": "http://192.168.0.40:8123/api/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:HOMEASSISTANT_TOKEN}",
      },
    },
    "jina": {
      "type": "remote",
      "url": "https://mcp.jina.ai/v1",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${env:JINA_API_KEY}"
      }
    },
    "safari": {
      "type": "local",
      "command": ["npx", "-y", "safari-mcp@2.15.11"],
      "enabled": true,
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
    },
    "chrome-use": {
      "type": "local",
      "command": ["/usr/bin/env", "-u", "AGENT_BROWSER_PROVIDER", "/usr/local/bin/chrome-use", "mcp", "--tools", "all"],
      "enabled": true,
    },
    "nuxt-ui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": false,
    },
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp",
      "enabled": false,
    },
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "oauth": false,
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientId": "{env:FIGMA_CLIENT_ID}",
        "clientSecret": "{env:FIGMA_CLIENT_SECRET}",
      },
      "enabled": false,
    },
    "tampermonkey": {
      "type": "local",
      "command": ["npx", "-y", "tampermonkey-mcp@latest"],
      "enabled": true,
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {},
    },
    "google-workspace-personal": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "cd \"$HOME/.config/google-workspace-personal\" && GEMINI_CLI_WORKSPACE_FORCE_FILE_STORAGE=true exec node workspace-server/dist/index.js --debug --use-dot-names",
      ],
      "enabled": true,
    },
    "google-workspace-work": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "cd \"$HOME/.config/google-workspace-work\" && GEMINI_CLI_WORKSPACE_FORCE_FILE_STORAGE=true exec node workspace-server/dist/index.js --debug --use-dot-names",
      ],
      "enabled": true,
    },
  },
  "permission": {
    "websearch": "allow",
    "external_directory": {
      "./*": "allow",
      "~/.claude/skills/*": "allow",
      "~/.agents/skills/*": "allow",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/tmp/*": "allow",
      "/private/var/tmp/*": "allow",
      "/private/var/folders/*": "allow",
      "/dev/*": "allow",
    },
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
    },
  },
}
